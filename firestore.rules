rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Usuario logueado y con el mail verificado (el login ya lo exige del lado del cliente).
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // usuarios: cada uno crea su propio registro, siempre sin aprobar.
    // La aprobación la hace un admin desde "Cuentas".
    match /usuarios/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.aprobado == false;
      allow update: if isVerified();
      allow delete: if false;
    }

    // admins: se cargan a mano desde la consola de Firebase.
    match /admins/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Datos de la flota y sus archivos de borrados.
    match /{coleccion}/{docId} {
      allow read, write: if isVerified() && coleccion in [
        'autos', 'servicios', 'alquileres',
        'autosArchivo', 'serviciosArchivo', 'alquileresArchivo',
        'contadores'
      ];
    }
  }
}
